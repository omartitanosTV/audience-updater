# -----------------------------------------------------------------------------
# Snowflake
# -----------------------------------------------------------------------------
SNOWFLAKE_USER=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# -----------------------------------------------------------------------------
# SpringServe
# -----------------------------------------------------------------------------
SPRINGSERVE_EMAIL=
SPRINGSERVE_PASSWORD=
SPRINGSERVE_BASE_URL=

# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------
DJANGO_SECRET_KEY=
AUDIENCE_SCHEDULE_TIMEZONE=Europe/Madrid

# Keep false for the simplest local setup.
# Set true only when Redis + a Celery worker are running.
AUDIENCE_ASYNC_REFRESH=false

# -----------------------------------------------------------------------------
# Celery / Redis (future integrated / production-style scheduler)
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
